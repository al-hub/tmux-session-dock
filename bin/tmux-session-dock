#!/usr/bin/env bash
# ==============================================================================
# bin/tmux-session-dock - CLI Entrypoint Wrapper
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Run dist bundle if built; otherwise fallback to modular development script
if [ -x "$REPO_ROOT/dist/tmux-session-dock" ]; then
    exec "$REPO_ROOT/dist/tmux-session-dock" "$@"
elif [ -x "$REPO_ROOT/scripts/tmux-session-dock" ]; then
    exec "$REPO_ROOT/scripts/tmux-session-dock" "$@"
else
    echo "tmux-session-dock: binary not found in $REPO_ROOT" >&2
    exit 1
fi
