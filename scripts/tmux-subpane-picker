#!/usr/bin/env bash
# ==============================================================================
# tmux-subpane-picker: Session Dock settings popup (Prefix + S)
#   section 1  subpane stack count / position
#   section 2  IME (한/영): English on sidebar focus, trigger scope, restore
# Toggle a row with Space or Enter; ↑/↓ (or k/j) move; Esc/q closes.
# ==============================================================================
set -euo pipefail

export LC_ALL="${LC_ALL:-C.UTF-8}"
export LANG="${LANG:-C.UTF-8}"

BOLD="\033[1m"
DIM="\033[2m"
RESET="\033[0m"
CYAN="\033[38;5;51m"
BLUE="\033[38;5;39m"
EMERALD="\033[38;5;48m"
YELLOW="\033[38;5;220m"
MAGENTA="\033[38;5;213m"
GRAY="\033[38;5;244m"
SELECTED_BG="\033[48;5;238m\033[38;5;51m\033[1m"

printf '\033[?25l'
trap "printf '\033[?25h\033[0m'" EXIT

# Resolve through the ~/.local/bin symlink so the repo's libs and dist are found.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" 2>/dev/null && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd)"
DOCK_BIN="$REPO_DIR/dist/tmux-session-dock"
[ -x "$DOCK_BIN" ] || DOCK_BIN="$HOME/.local/bin/tmux-session-dock"
[ -x "$DOCK_BIN" ] || DOCK_BIN="$(command -v tmux-session-dock 2>/dev/null || true)"

# Source lib if available
[ -r "$REPO_DIR/scripts/lib/sidebar_port_tmux.sh" ] && source "$REPO_DIR/scripts/lib/sidebar_port_tmux.sh"
[ -r "$REPO_DIR/scripts/lib/sidebar_subpane_hub.sh" ] && source "$REPO_DIR/scripts/lib/sidebar_subpane_hub.sh"

get_subpane_count() {
    tmux show-option -gqv "@session-dock-subpane-count" 2>/dev/null || echo "1"
}

get_subpane_pos() {
    tmux show-option -gqv "@session-dock-subpane-position" 2>/dev/null || echo "bottom"
}

set_subpane_config() {
    local cnt="$1" pos="$2"
    tmux set-option -gq "@session-dock-subpane-count" "$cnt" 2>/dev/null || true
    tmux set-option -gq "@session-dock-subpane-position" "$pos" 2>/dev/null || true
}

# IME state from the dock binary:
#   "setting=off|on|restore trigger=any|keybind backend=<name> hook_in=... hook_out=..."
IME_SETTING="off"
IME_TRIGGER="any"
IME_BACKEND="none"
read_ime_status() {
    local status=""
    if [ -n "$DOCK_BIN" ] && [ -x "$DOCK_BIN" ]; then
        status="$("$DOCK_BIN" --ime-status 2>/dev/null || true)"
    fi
    IME_SETTING="$(printf '%s' "$status" | sed -n 's/.*setting=\([a-z]*\).*/\1/p')"
    IME_TRIGGER="$(printf '%s' "$status" | sed -n 's/.*trigger=\([a-z]*\).*/\1/p')"
    IME_BACKEND="$(printf '%s' "$status" | sed -n 's/.*backend=\([a-z0-9-]*\).*/\1/p')"
    [ -n "$IME_SETTING" ] || IME_SETTING="off"
    [ -n "$IME_TRIGGER" ] || IME_TRIGGER="any"
    [ -n "$IME_BACKEND" ] || IME_BACKEND="none"
}

dock_cmd() {
    [ -n "$DOCK_BIN" ] && [ -x "$DOCK_BIN" ] || return 0
    "$DOCK_BIN" "$@" >/dev/null 2>&1 || true
}

# Remembered so that turning IME off and on again keeps the restore choice.
IME_LAST_ON_MODE="on"

CURRENT_COUNT="$(get_subpane_count)"
[ -n "$CURRENT_COUNT" ] || CURRENT_COUNT="1"
CURRENT_POS="$(get_subpane_pos)"
[ -n "$CURRENT_POS" ] || CURRENT_POS="bottom"
read_ime_status
[ "$IME_SETTING" = "off" ] || IME_LAST_ON_MODE="$IME_SETTING"

# id|title|description. Rows whose id starts with "#" are section headers and
# are skipped by the cursor.
OPTIONS=(
    "#SUB|서브페인 스택 (Subpane Stack)|"
    "1|1 Slot (Single Subpane)|기본 1개 터미널 (14줄 전체 할당)"
    "2|2 Slots (Dual Stack)|수직 2단 직렬 스택 (7줄 + 7줄 분할)"
    "3|3 Slots (Triple Stack)|수직 3단 직렬 스택 (5줄 + 5줄 + 5줄 분할)"
    "POS|Toggle Position (Top ↔ Bottom)|"
    "#IME|IME 한/영 (Input Method)|"
    "IME|IME → English on Sidebar Focus|"
    "TRIG|Trigger: Keybind Only|"
    "REST|Restore IME on Leave|"
)

is_header() { case "$1" in \#*) return 0 ;; *) return 1 ;; esac; }
option_id() { printf '%s' "$1" | cut -d'|' -f1; }

SELECTED_IDX=1
case "$CURRENT_COUNT" in
    1) SELECTED_IDX=1 ;;
    2) SELECTED_IDX=2 ;;
    3) SELECTED_IDX=3 ;;
esac

move_cursor() {   # move_cursor +1|-1, skipping headers
    local step="$1" n="${#OPTIONS[@]}" i="$SELECTED_IDX"
    while :; do
        i=$(( (i + step + n) % n ))
        is_header "$(option_id "${OPTIONS[$i]}")" || break
    done
    SELECTED_IDX="$i"
}

draw_picker() {
    clear 2>/dev/null || true
    CURRENT_POS="$(get_subpane_pos)"
    [ -n "$CURRENT_POS" ] || CURRENT_POS="bottom"
    CURRENT_COUNT="$(get_subpane_count)"
    [ -n "$CURRENT_COUNT" ] || CURRENT_COUNT="1"
    read_ime_status

    printf "${CYAN}${BOLD}╭──────────────────────────────────────────────────────────────────────────╮${RESET}\n"
    printf "${CYAN}${BOLD}│${RESET}  ${YELLOW}${BOLD}⚙️ 사이드바 설정 (Session Dock Settings)${RESET}                            ${CYAN}${BOLD}│${RESET}\n"
    printf "${CYAN}${BOLD}╰──────────────────────────────────────────────────────────────────────────╯${RESET}\n"

    local i=0
    for opt in "${OPTIONS[@]}"; do
        local id title desc
        id="$(printf '%s' "$opt" | cut -d'|' -f1)"
        title="$(printf '%s' "$opt" | cut -d'|' -f2)"
        desc="$(printf '%s' "$opt" | cut -d'|' -f3)"

        if is_header "$id"; then
            printf "\n  ${BLUE}${BOLD}── %s ${RESET}${GRAY}──────────────────────────────────────────${RESET}\n" "$title"
            i=$((i + 1))
            continue
        fi

        local is_active=false disabled=false
        [ "$id" = "$CURRENT_COUNT" ] && is_active=true
        case "$id" in
            POS)
                desc="현재 위치: ${BOLD}${EMERALD}${CURRENT_POS^^}${RESET}${GRAY} (Top ↔ Bottom 즉시 스왑)${RESET}"
                ;;
            IME)
                if [ "$IME_BACKEND" = "none" ]; then
                    disabled=true
                    desc="사용 불가: IME 헬퍼 없음 ${DIM}(WSL: ./setup.sh update / Linux: fcitx5·fcitx·ibus / macOS: im-select)${RESET}"
                elif [ "$IME_SETTING" != "off" ]; then
                    is_active=true
                    desc="사이드바 진입 시 영문 전환 ${DIM}· 백엔드 ${IME_BACKEND}${RESET}"
                else
                    desc="사이드바 진입 시 영문 전환 ${DIM}· 백엔드 ${IME_BACKEND} (한글 상태에서도 j/k/d 단축키 동작)${RESET}"
                fi
                ;;
            TRIG)
                if [ "$IME_BACKEND" = "none" ] || [ "$IME_SETTING" = "off" ]; then
                    disabled=true
                    desc="${DIM}IME 전환이 꺼져 있어 비활성${RESET}"
                elif [ "$IME_TRIGGER" = "keybind" ]; then
                    is_active=true
                    desc="키바인드(Alt+s · Alt+←)로 들어올 때만 전환 ${DIM}(마우스 클릭·Prefix+s는 그대로)${RESET}"
                else
                    desc="현재: ${BOLD}${EMERALD}ANY FOCUS${RESET}${GRAY} — 마우스·세션 전환 포함 모든 진입에서 전환${RESET}"
                fi
                ;;
            REST)
                if [ "$IME_BACKEND" = "none" ] || [ "$IME_SETTING" = "off" ]; then
                    disabled=true
                    desc="${DIM}IME 전환이 꺼져 있어 비활성${RESET}"
                elif [ "$IME_SETTING" = "restore" ]; then
                    is_active=true
                    desc="사이드바를 떠날 때 원래 한/영 상태로 복원"
                else
                    desc="사이드바를 떠날 때 원래 한/영 상태로 복원 ${DIM}(꺼짐: 영문 유지)${RESET}"
                fi
                ;;
        esac

        local mark="[ ]"
        [ "$is_active" = true ] && mark="[✓]"
        if [ "$i" -eq "$SELECTED_IDX" ]; then
            printf "  ${SELECTED_BG} ▸ %s %-30s ${RESET} ${CYAN}─ %b${RESET}\n" "$mark" "$title" "$desc"
        elif [ "$disabled" = true ]; then
            printf "    ${DIM}%s %-30s${RESET} ${GRAY}─ %b${RESET}\n" "$mark" "$title" "$desc"
        elif [ "$is_active" = true ]; then
            printf "    ${EMERALD}${BOLD}%s %-30s${RESET} ${GRAY}─ %b${RESET}\n" "$mark" "$title" "$desc"
        else
            printf "    ${DIM}%s %-30s${RESET} ${GRAY}─ %b${RESET}\n" "$mark" "$title" "$desc"
        fi
        i=$((i + 1))
    done

    printf "\n${GRAY}──────────────────────────────────────────────────────────────────────────${RESET}\n"
    printf "  ${DIM}이동:${RESET} ${BOLD}${YELLOW}[ ↑ / ↓ ]${RESET} ${DIM}| 토글 & 적용:${RESET} ${BOLD}${EMERALD}[ Space / Enter ]${RESET} ${DIM}| 닫기:${RESET} ${BOLD}${YELLOW}[ Esc / q ]${RESET}\n"
}

apply_selection() {
    local chosen_id
    chosen_id="$(option_id "${OPTIONS[$SELECTED_IDX]}")"
    case "$chosen_id" in
        POS)
            if [ "$CURRENT_POS" = "bottom" ]; then
                set_subpane_config "$CURRENT_COUNT" "top"
            else
                set_subpane_config "$CURRENT_COUNT" "bottom"
            fi
            ;;
        IME)
            [ "$IME_BACKEND" != "none" ] || return 0
            if [ "$IME_SETTING" = "off" ]; then
                dock_cmd --ime-set "$IME_LAST_ON_MODE"
            else
                IME_LAST_ON_MODE="$IME_SETTING"
                dock_cmd --ime-set off
            fi
            ;;
        TRIG)
            [ "$IME_BACKEND" != "none" ] && [ "$IME_SETTING" != "off" ] || return 0
            if [ "$IME_TRIGGER" = "keybind" ]; then
                dock_cmd --ime-set-trigger any
            else
                dock_cmd --ime-set-trigger keybind
            fi
            ;;
        REST)
            [ "$IME_BACKEND" != "none" ] && [ "$IME_SETTING" != "off" ] || return 0
            if [ "$IME_SETTING" = "restore" ]; then
                dock_cmd --ime-set on
            else
                dock_cmd --ime-set restore
            fi
            ;;
        *)
            set_subpane_config "$chosen_id" "$CURRENT_POS"
            ;;
    esac
}

draw_picker

while IFS= read -rsn1 key; do
    case "$key" in
        $'\e')
            read -rsn2 -t 0.05 extra 2>/dev/null || true
            if [ -z "$extra" ]; then
                exit 0
            elif [ "$extra" = "[A" ] || [ "$extra" = "OA" ]; then
                move_cursor -1
                draw_picker
            elif [ "$extra" = "[B" ] || [ "$extra" = "OB" ]; then
                move_cursor 1
                draw_picker
            fi
            ;;
        k|K)
            move_cursor -1
            draw_picker
            ;;
        j|J)
            move_cursor 1
            draw_picker
            ;;
        " "|""|$'\n'|$'\r')
            apply_selection
            draw_picker
            ;;
        q|Q)
            exit 0
            ;;
    esac
done
