#!/usr/bin/env bash
# ==============================================================================
# tmux-subpane-picker: Session Dock settings popup (Prefix + S)
#   section 1  subpane stack count / position
#   section 2  IME (한/영): English on sidebar focus, restore on leave
#   section 3  switch recovery
#   section 4  activity gradient: on/off and cycle length in milliseconds
#   section 5  awaiting: mark sessions that stopped and have not been visited
# Toggle a row with Space or Enter; ↑/↓ (or k/j) move; Esc/q closes.
# The gradient speed row opens an inline millisecond prompt instead.
# ==============================================================================
set -euo pipefail

export LC_ALL="${LC_ALL:-C.UTF-8}"
export LANG="${LANG:-C.UTF-8}"

BOLD="\033[1m"
DIM="\033[2m"
RESET="\033[0m"
CYAN="\033[38;5;51m"
BLUE="\033[38;5;39m"
EMERALD="\033[38;5;48m"
YELLOW="\033[38;5;220m"
MAGENTA="\033[38;5;213m"
GRAY="\033[38;5;244m"
SELECTED_BG="\033[48;5;238m\033[38;5;51m\033[1m"

printf '\033[?25l'
trap "printf '\033[?25h\033[0m'" EXIT

# Resolve through the ~/.local/bin symlink so the repo's libs and dist are found.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" 2>/dev/null && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd)"
DOCK_BIN="$REPO_DIR/dist/tmux-session-dock"
[ -x "$DOCK_BIN" ] || DOCK_BIN="$HOME/.local/bin/tmux-session-dock"
[ -x "$DOCK_BIN" ] || DOCK_BIN="$(command -v tmux-session-dock 2>/dev/null || true)"

# Source lib if available
[ -r "$REPO_DIR/scripts/lib/sidebar_port_tmux.sh" ] && source "$REPO_DIR/scripts/lib/sidebar_port_tmux.sh"
[ -r "$REPO_DIR/scripts/lib/sidebar_subpane_hub.sh" ] && source "$REPO_DIR/scripts/lib/sidebar_subpane_hub.sh"

# The clamp lives in the domain lib so the popup and the presenter cannot
# disagree about what a millisecond value means.
[ -r "$REPO_DIR/scripts/lib/sidebar_domain_animation.sh" ] &&
    source "$REPO_DIR/scripts/lib/sidebar_domain_animation.sh"
[ -r "$REPO_DIR/scripts/lib/sidebar_domain_activity.sh" ] &&
    source "$REPO_DIR/scripts/lib/sidebar_domain_activity.sh"

get_awaiting_enabled() {
    local v
    v="$(tmux show-option -gqv "@session-dock-awaiting" 2>/dev/null || true)"
    case "$v" in off|false|0) printf 'off' ;; *) printf 'on' ;; esac
}

get_awaiting_blink() {
    local v
    v="$(tmux show-option -gqv "@session-dock-awaiting-blink" 2>/dev/null || true)"
    case "$v" in
        off|false|0) printf 'off' ;;
        ''|always|true) printf 'always' ;;
        *[!0-9]*) printf 'always' ;;
        *) printf '%s' "$v" ;;
    esac
}

get_awaiting_after() {
    local v
    v="$(tmux show-option -gqv "@session-dock-awaiting-after" 2>/dev/null || true)"
    if declare -f sidebar_domain_activity_await_after >/dev/null 2>&1; then
        sidebar_domain_activity_await_after "$v"
        printf '%s' "$sidebar_awaiting_after_ms_result"
        return 0
    fi
    case "$v" in ''|*[!0-9]*) printf '30000' ;; *) printf '%s' "$v" ;; esac
}

get_gradient_enabled() {
    local v
    v="$(tmux show-option -gqv "@session-dock-gradient" 2>/dev/null || true)"
    case "$v" in off|false|0) printf 'off' ;; *) printf 'on' ;; esac
}

get_gradient_speed() {
    local v
    v="$(tmux show-option -gqv "@session-dock-gradient-speed" 2>/dev/null || true)"
    if declare -f sidebar_domain_animation_timing >/dev/null 2>&1; then
        sidebar_domain_animation_timing "$v"
        printf '%s' "$sidebar_animation_timing_cycle_ms"
        return 0
    fi
    case "$v" in ''|*[!0-9]*) printf '1000' ;; *) printf '%s' "$v" ;; esac
}

get_subpane_count() {
    tmux show-option -gqv "@session-dock-subpane-count" 2>/dev/null || echo "1"
}

get_subpane_pos() {
    tmux show-option -gqv "@session-dock-subpane-position" 2>/dev/null || echo "bottom"
}

set_subpane_config() {
    local cnt="$1" pos="$2"
    tmux set-option -gq "@session-dock-subpane-count" "$cnt" 2>/dev/null || true
    tmux set-option -gq "@session-dock-subpane-position" "$pos" 2>/dev/null || true
}

# IME state from the dock binary:
#   "setting=off|on|restore backend=<name> hook_in=... hook_out=..."
IME_SETTING="off"
IME_BACKEND="none"
read_ime_status() {
    local status=""
    if [ -n "$DOCK_BIN" ] && [ -x "$DOCK_BIN" ]; then
        status="$("$DOCK_BIN" --ime-status 2>/dev/null || true)"
    fi
    IME_SETTING="$(printf '%s' "$status" | sed -n 's/.*setting=\([a-z]*\).*/\1/p')"
    IME_BACKEND="$(printf '%s' "$status" | sed -n 's/.*backend=\([a-z0-9-]*\).*/\1/p')"
    [ -n "$IME_SETTING" ] || IME_SETTING="off"
    [ -n "$IME_BACKEND" ] || IME_BACKEND="none"
}

dock_cmd() {
    [ -n "$DOCK_BIN" ] && [ -x "$DOCK_BIN" ] || return 0
    "$DOCK_BIN" "$@" >/dev/null 2>&1 || true
}

# Remembered so that turning IME off and on again keeps the restore choice.
IME_LAST_ON_MODE="on"

CURRENT_COUNT="$(get_subpane_count)"
[ -n "$CURRENT_COUNT" ] || CURRENT_COUNT="1"
CURRENT_POS="$(get_subpane_pos)"
[ -n "$CURRENT_POS" ] || CURRENT_POS="bottom"
read_ime_status
[ "$IME_SETTING" = "off" ] || IME_LAST_ON_MODE="$IME_SETTING"

# id|title|description. Rows whose id starts with "#" are section headers and
# are skipped by the cursor.
OPTIONS=(
    "#SUB|서브페인 스택 (Subpane Stack)|"
    "1|1 Slot (Single Subpane)|기본 1개 터미널 (14줄 전체 할당)"
    "2|2 Slots (Dual Stack)|수직 2단 직렬 스택 (7줄 + 7줄 분할)"
    "3|3 Slots (Triple Stack)|수직 3단 직렬 스택 (5줄 + 5줄 + 5줄 분할)"
    "POS|Toggle Position (Top ↔ Bottom)|"
    "#IME|IME 한/영 (Input Method)|"
    "IME|IME → English on Sidebar Focus|"
    "REST|Restore IME on Leave|"
    "#RECOV|세션 전환 복구 (Switch Recovery)|"
    "RECOV|On Failure: Ask / Auto / Off|"
    "#GRAD|활동 그라디언트 (Activity Gradient)|"
    "GRAD|Gradient on Active Sessions|"
    "GSPD|Wave Cycle (ms)|"
    "#AWAIT|미확인 정지 (Awaiting)|"
    "AWAIT|Awaiting Marker|"
    "ABLINK|Blink Until Seen|"
    "AAFTER|Mark After (ms)|"
)

is_header() { case "$1" in \#*) return 0 ;; *) return 1 ;; esac; }
option_id() { printf '%s' "$1" | cut -d'|' -f1; }

SELECTED_IDX=1
case "$CURRENT_COUNT" in
    1) SELECTED_IDX=1 ;;
    2) SELECTED_IDX=2 ;;
    3) SELECTED_IDX=3 ;;
esac

move_cursor() {   # move_cursor +1|-1, skipping headers
    local step="$1" n="${#OPTIONS[@]}" i="$SELECTED_IDX"
    while :; do
        i=$(( (i + step + n) % n ))
        is_header "$(option_id "${OPTIONS[$i]}")" || break
    done
    SELECTED_IDX="$i"
}

draw_picker() {
    clear 2>/dev/null || true
    CURRENT_POS="$(get_subpane_pos)"
    [ -n "$CURRENT_POS" ] || CURRENT_POS="bottom"
    CURRENT_COUNT="$(get_subpane_count)"
    [ -n "$CURRENT_COUNT" ] || CURRENT_COUNT="1"
    read_ime_status

    printf "${CYAN}${BOLD}╭──────────────────────────────────────────────────────────────────────────╮${RESET}\n"
    printf "${CYAN}${BOLD}│${RESET}  ${YELLOW}${BOLD}⚙️ 사이드바 설정 (Session Dock Settings)${RESET}                            ${CYAN}${BOLD}│${RESET}\n"
    printf "${CYAN}${BOLD}╰──────────────────────────────────────────────────────────────────────────╯${RESET}\n"

    local i=0
    for opt in "${OPTIONS[@]}"; do
        local id title desc
        id="$(printf '%s' "$opt" | cut -d'|' -f1)"
        title="$(printf '%s' "$opt" | cut -d'|' -f2)"
        desc="$(printf '%s' "$opt" | cut -d'|' -f3)"

        if is_header "$id"; then
            printf "\n  ${BLUE}${BOLD}── %s ${RESET}${GRAY}──────────────────────────────────────────${RESET}\n" "$title"
            i=$((i + 1))
            continue
        fi

        local is_active=false disabled=false
        [ "$id" = "$CURRENT_COUNT" ] && is_active=true
        case "$id" in
            POS)
                desc="현재 위치: ${BOLD}${EMERALD}${CURRENT_POS^^}${RESET}${GRAY} (Top ↔ Bottom 즉시 스왑)${RESET}"
                ;;
            IME)
                if [ "$IME_BACKEND" = "none" ]; then
                    disabled=true
                    desc="사용 불가: IME 헬퍼 없음 ${DIM}(WSL: ./setup.sh update / Linux: fcitx5·fcitx·ibus / macOS: im-select)${RESET}"
                elif [ "$IME_SETTING" != "off" ]; then
                    is_active=true
                    desc="어떤 경로로 들어와도(Alt+s · Alt+← · 마우스) 영문 전환 ${DIM}· 백엔드 ${IME_BACKEND}${RESET}"
                else
                    desc="사이드바 진입 시 영문 전환 ${DIM}· 백엔드 ${IME_BACKEND} (한글 상태에서도 j/k/d 단축키 동작)${RESET}"
                fi
                ;;
            RECOV)
                local recov
                recov="$(tmux show-option -gqv @session-dock-switch-recovery 2>/dev/null || true)"
                case "$recov" in auto|off) ;; *) recov="popup" ;; esac
                is_active=true
                case "$recov" in
                    popup) desc="현재: ${BOLD}${EMERALD}ASK${RESET}${GRAY} — 대상 사이드바 이상 시 진단 팝업으로 선택 (Space: AUTO)${RESET}" ;;
                    auto)  desc="현재: ${BOLD}${EMERALD}AUTO${RESET}${GRAY} — 사이드바 자동 재기동 후 전환, 팝업 없음 (Space: OFF)${RESET}" ;;
                    off)   is_active=false; desc="현재: ${BOLD}${YELLOW}OFF${RESET}${GRAY} — 조용히 실패, footer 메시지만 (Space: ASK)${RESET}" ;;
                esac
                ;;
            GRAD)
                if [ "$(get_gradient_enabled)" = "on" ]; then
                    is_active=true
                    desc="AI CLI가 도는 세션 행에 파형 표시 ${DIM}(Space: 끄기 — 끄면 프레임 깨우기도 멈춤)${RESET}"
                else
                    desc="현재 ${BOLD}${YELLOW}OFF${RESET}${GRAY} — 행을 정적으로 그리고 프레임 깨우기 없음 (Space: 켜기)${RESET}"
                fi
                ;;
            GSPD)
                local gms
                gms="$(get_gradient_speed)"
                if [ "$(get_gradient_enabled)" = "on" ]; then
                    is_active=true
                    desc="한 주기 ${BOLD}${EMERALD}${gms} ms${RESET}${GRAY} · 24프레임 ≈ $(( 24000 / gms )) fps ${DIM}(Enter: ms 직접 입력, ${SIDEBAR_ANIMATION_CYCLE_MS_MIN:-400}~${SIDEBAR_ANIMATION_CYCLE_MS_MAX:-4000})${RESET}"
                else
                    disabled=true
                    desc="${DIM}그라디언트가 꺼져 있어 비활성 (현재 ${gms} ms)${RESET}"
                fi
                ;;
            AWAIT)
                if [ "$(get_awaiting_enabled)" = "on" ]; then
                    is_active=true
                    desc="멈춘 뒤 아직 안 가본 세션에 ● 표시 ${DIM}(Space: 끄기)${RESET}"
                else
                    desc="현재 ${BOLD}${YELLOW}OFF${RESET}${GRAY} — 표시 없음 (Space: 켜기)${RESET}"
                fi
                ;;
            ABLINK)
                local ablink
                ablink="$(get_awaiting_blink)"
                if [ "$(get_awaiting_enabled)" != "on" ]; then
                    disabled=true
                    desc="${DIM}Awaiting 표시가 꺼져 있어 비활성${RESET}"
                elif [ "$ablink" = "off" ]; then
                    desc="현재 ${BOLD}${YELLOW}OFF${RESET}${GRAY} — 정적 ● (Space: always / Enter: ms 지정)${RESET}"
                elif [ "$ablink" = "always" ]; then
                    is_active=true
                    desc="확인할 때까지 계속 깜빡임 ${DIM}(Space: 끄기 / Enter: ms 지정)${RESET}"
                else
                    is_active=true
                    desc="${BOLD}${EMERALD}${ablink} ms${RESET}${GRAY} 동안만 깜빡인 뒤 정적 ${DIM}(상태는 그대로 유지)${RESET}"
                fi
                ;;
            AAFTER)
                local aafter
                aafter="$(get_awaiting_after)"
                if [ "$(get_awaiting_enabled)" != "on" ]; then
                    disabled=true
                    desc="${DIM}Awaiting 표시가 꺼져 있어 비활성 (현재 ${aafter} ms)${RESET}"
                else
                    is_active=true
                    desc="멈춘 뒤 ${BOLD}${EMERALD}${aafter} ms${RESET}${GRAY} 지나면 표시 ${DIM}(Enter: 직접 입력, ${SIDEBAR_AWAITING_AFTER_MS_MIN:-1000}~${SIDEBAR_AWAITING_AFTER_MS_MAX:-300000})${RESET}"
                fi
                ;;
            REST)
                if [ "$IME_BACKEND" = "none" ] || [ "$IME_SETTING" = "off" ]; then
                    disabled=true
                    desc="${DIM}IME 전환이 꺼져 있어 비활성${RESET}"
                elif [ "$IME_SETTING" = "restore" ]; then
                    is_active=true
                    desc="사이드바를 떠날 때 원래 한/영 상태로 복원"
                else
                    desc="사이드바를 떠날 때 원래 한/영 상태로 복원 ${DIM}(꺼짐: 영문 유지)${RESET}"
                fi
                ;;
        esac

        local mark="[ ]"
        [ "$is_active" = true ] && mark="[✓]"
        if [ "$i" -eq "$SELECTED_IDX" ]; then
            printf "  ${SELECTED_BG} ▸ %s %-30s ${RESET} ${CYAN}─ %b${RESET}\n" "$mark" "$title" "$desc"
        elif [ "$disabled" = true ]; then
            printf "    ${DIM}%s %-30s${RESET} ${GRAY}─ %b${RESET}\n" "$mark" "$title" "$desc"
        elif [ "$is_active" = true ]; then
            printf "    ${EMERALD}${BOLD}%s %-30s${RESET} ${GRAY}─ %b${RESET}\n" "$mark" "$title" "$desc"
        else
            printf "    ${DIM}%s %-30s${RESET} ${GRAY}─ %b${RESET}\n" "$mark" "$title" "$desc"
        fi
        i=$((i + 1))
    done

    printf "\n${GRAY}──────────────────────────────────────────────────────────────────────────${RESET}\n"
    printf "  ${DIM}이동:${RESET} ${BOLD}${YELLOW}[ ↑ / ↓ ]${RESET} ${DIM}| 토글 & 적용:${RESET} ${BOLD}${EMERALD}[ Space / Enter ]${RESET} ${DIM}| 값 입력:${RESET} ${BOLD}${EMERALD}[ 숫자 ]${RESET} ${DIM}| 닫기:${RESET} ${BOLD}${YELLOW}[ Esc / q ]${RESET}\n"
}

# Read a millisecond value on the footer line, for whichever option asked.
# Digits type, Backspace deletes, Enter commits, Esc cancels; a value outside
# the range is clamped rather than refused, with the same bounds the presenter
# applies, so the popup and the dock cannot disagree about what a number means.
prompt_ms_value() {
    local option="$1" current="$2" min="$3" max="$4" label="$5"
    local entry="" key extra
    while :; do
        printf "\r\033[2K  ${BOLD}${EMERALD}%s:${RESET} ${BOLD}%s${RESET}${DIM}▏${RESET}  ${GRAY}현재 %s · 범위 %s~%s · Enter 적용 · Esc 취소${RESET}" \
            "$label" "$entry" "$current" "$min" "$max"
        IFS= read -rsn1 key || return 0
        case "$key" in
            $'\e')
                read -rsn2 -t 0.05 extra 2>/dev/null || true
                [ -n "$extra" ] || return 0
                ;;
            ""|$'\n'|$'\r')
                [ -n "$entry" ] || return 0
                [ "$entry" -lt "$min" ] 2>/dev/null && entry="$min"
                [ "$entry" -gt "$max" ] 2>/dev/null && entry="$max"
                tmux set-option -gq "$option" "$entry"
                return 0
                ;;
            $'\177'|$'\b') entry="${entry%?}" ;;
            [0-9]) [ "${#entry}" -lt 6 ] && entry+="$key" ;;
        esac
    done
}

# key_is_enter lets one row mean two things: Space cycles between the keyword
# values, Enter asks for a number. Every other row treats them the same.
key_is_enter=false
apply_selection() {
    local chosen_id
    chosen_id="$(option_id "${OPTIONS[$SELECTED_IDX]}")"
    case "$chosen_id" in
        POS)
            if [ "$CURRENT_POS" = "bottom" ]; then
                set_subpane_config "$CURRENT_COUNT" "top"
            else
                set_subpane_config "$CURRENT_COUNT" "bottom"
            fi
            ;;
        IME)
            [ "$IME_BACKEND" != "none" ] || return 0
            if [ "$IME_SETTING" = "off" ]; then
                dock_cmd --ime-set "$IME_LAST_ON_MODE"
            else
                IME_LAST_ON_MODE="$IME_SETTING"
                dock_cmd --ime-set off
            fi
            ;;
        RECOV)
            local recov
            recov="$(tmux show-option -gqv @session-dock-switch-recovery 2>/dev/null || true)"
            case "$recov" in
                auto) tmux set-option -gq @session-dock-switch-recovery off ;;
                off)  tmux set-option -gq @session-dock-switch-recovery popup ;;
                *)    tmux set-option -gq @session-dock-switch-recovery auto ;;
            esac
            ;;
        GRAD)
            if [ "$(get_gradient_enabled)" = "on" ]; then
                tmux set-option -gq "@session-dock-gradient" off
            else
                tmux set-option -gq "@session-dock-gradient" on
            fi
            ;;
        GSPD)
            [ "$(get_gradient_enabled)" = "on" ] || return 0
            prompt_ms_value "@session-dock-gradient-speed" "$(get_gradient_speed)" \
                "${SIDEBAR_ANIMATION_CYCLE_MS_MIN:-400}" "${SIDEBAR_ANIMATION_CYCLE_MS_MAX:-4000}" "주기(ms)"
            ;;
        AWAIT)
            if [ "$(get_awaiting_enabled)" = "on" ]; then
                tmux set-option -gq "@session-dock-awaiting" off
            else
                tmux set-option -gq "@session-dock-awaiting" on
            fi
            ;;
        ABLINK)
            [ "$(get_awaiting_enabled)" = "on" ] || return 0
            if [ "$key_is_enter" = true ]; then
                prompt_ms_value "@session-dock-awaiting-blink" "$(get_awaiting_blink)" \
                    100 600000 "깜빡임(ms)"
            elif [ "$(get_awaiting_blink)" = "off" ]; then
                tmux set-option -gq "@session-dock-awaiting-blink" always
            else
                tmux set-option -gq "@session-dock-awaiting-blink" off
            fi
            ;;
        AAFTER)
            [ "$(get_awaiting_enabled)" = "on" ] || return 0
            prompt_ms_value "@session-dock-awaiting-after" "$(get_awaiting_after)" \
                "${SIDEBAR_AWAITING_AFTER_MS_MIN:-1000}" "${SIDEBAR_AWAITING_AFTER_MS_MAX:-300000}" "표시까지(ms)"
            ;;
        REST)
            [ "$IME_BACKEND" != "none" ] && [ "$IME_SETTING" != "off" ] || return 0
            if [ "$IME_SETTING" = "restore" ]; then
                dock_cmd --ime-set on
            else
                dock_cmd --ime-set restore
            fi
            ;;
        *)
            set_subpane_config "$chosen_id" "$CURRENT_POS"
            ;;
    esac
}

draw_picker

while IFS= read -rsn1 key; do
    case "$key" in
        $'\e')
            read -rsn2 -t 0.05 extra 2>/dev/null || true
            if [ -z "$extra" ]; then
                exit 0
            elif [ "$extra" = "[A" ] || [ "$extra" = "OA" ]; then
                move_cursor -1
                draw_picker
            elif [ "$extra" = "[B" ] || [ "$extra" = "OB" ]; then
                move_cursor 1
                draw_picker
            fi
            ;;
        k|K)
            move_cursor -1
            draw_picker
            ;;
        j|J)
            move_cursor 1
            draw_picker
            ;;
        " ")
            key_is_enter=false
            apply_selection
            draw_picker
            ;;
        ""|$'\n'|$'\r')
            key_is_enter=true
            apply_selection
            draw_picker
            ;;
        q|Q)
            exit 0
            ;;
    esac
done
