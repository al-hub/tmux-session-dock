#!/usr/bin/env bash
set -euo pipefail

# Ensure UTF-8 locale for accurate multi-byte input reading
export LC_ALL="${LC_ALL:-C.UTF-8}"
export LANG="${LANG:-C.UTF-8}"

resolve_launcher_dir() {
    local target="${BASH_SOURCE[0]}"
    if [[ "$target" == /dev/fd/* ]] || [[ "$target" == /proc/* ]] || [ ! -e "$target" ]; then
        if [ -n "${LAUNCHER:-}" ] && [ -e "$LAUNCHER" ]; then
            target="$LAUNCHER"
        fi
    fi
    while [ -L "$target" ]; do
        case "$target" in
            /dev/fd/*|/proc/*) break ;;
        esac
        local dir
        dir="$(cd -P "$(dirname "$target")" 2>/dev/null && pwd || true)"
        [ -n "$dir" ] || break
        local link_target
        link_target="$(readlink "$target" 2>/dev/null || true)"
        [ -n "$link_target" ] || break
        target="$link_target"
        [[ $target != /* ]] && target="$dir/$target"
    done
    local final_dir
    final_dir="$(cd -P "$(dirname "$target")" 2>/dev/null && pwd || true)"
    if [ -z "$final_dir" ] || [ ! -d "$final_dir/lib" ]; then
        if [ -n "${LAUNCHER:-}" ] && [ -r "$LAUNCHER" ]; then
            final_dir="$(cd -P "$(dirname "$LAUNCHER")" 2>/dev/null && pwd || true)"
        fi
    fi
    echo "${final_dir:-.}"
}
LAUNCHER_DIR="$(resolve_launcher_dir)"
SIDEBAR_ADAPTER_PATH="$LAUNCHER_DIR/tmux-sidebar-tmux-adapter"
[ -r "$SIDEBAR_ADAPTER_PATH" ] || {
    launcher_test_dir="${LAUNCHER:-}"
    [ -n "$launcher_test_dir" ] && launcher_test_dir="$(cd "$(dirname "$launcher_test_dir")" && pwd)"
    [ -n "$launcher_test_dir" ] && SIDEBAR_ADAPTER_PATH="$launcher_test_dir/tmux-sidebar-tmux-adapter"
}
[ -r "$SIDEBAR_ADAPTER_PATH" ] || {
    [ -r "$LAUNCHER_DIR/tmux-sidebar-tmux-adapter" ] && SIDEBAR_ADAPTER_PATH="$LAUNCHER_DIR/tmux-sidebar-tmux-adapter"
}
[ -r "$SIDEBAR_ADAPTER_PATH" ] || {
    [ -r "$LAUNCHER_DIR/../dist/tmux-sidebar-tmux-adapter" ] && SIDEBAR_ADAPTER_PATH="$LAUNCHER_DIR/../dist/tmux-sidebar-tmux-adapter"
}
[ -r "$SIDEBAR_ADAPTER_PATH" ] || {
    printf 'tmux-session-dock: missing tmux adapter: %s\n' "$SIDEBAR_ADAPTER_PATH" >&2
    exit 1
}
# Sourced in dev; bundled in prod
[ -r "$LAUNCHER_DIR/lib/sidebar_domain.sh" ] && source "$LAUNCHER_DIR/lib/sidebar_domain.sh"
[ -r "$LAUNCHER_DIR/lib/sidebar_domain_animation.sh" ] && source "$LAUNCHER_DIR/lib/sidebar_domain_animation.sh"
[ -r "$LAUNCHER_DIR/lib/sidebar_domain_activity.sh" ] && source "$LAUNCHER_DIR/lib/sidebar_domain_activity.sh"
[ -r "$LAUNCHER_DIR/lib/sidebar_port_tmux.sh" ] && source "$LAUNCHER_DIR/lib/sidebar_port_tmux.sh"
[ -r "$LAUNCHER_DIR/lib/sidebar_subpane_hub.sh" ] && source "$LAUNCHER_DIR/lib/sidebar_subpane_hub.sh"
[ -r "$LAUNCHER_DIR/lib/sidebar_topology.sh" ] && source "$LAUNCHER_DIR/lib/sidebar_topology.sh"
[ -r "$LAUNCHER_DIR/lib/sidebar_switch.sh" ] && source "$LAUNCHER_DIR/lib/sidebar_switch.sh"
[ -r "$LAUNCHER_DIR/lib/sidebar_presenter.sh" ] && source "$LAUNCHER_DIR/lib/sidebar_presenter.sh"
[ -r "$LAUNCHER_DIR/lib/sidebar_ime.sh" ] && source "$LAUNCHER_DIR/lib/sidebar_ime.sh"
[ -r "$LAUNCHER_DIR/lib/sidebar_coordinator.sh" ] && source "$LAUNCHER_DIR/lib/sidebar_coordinator.sh"
[ -r "$LAUNCHER_DIR/lib/sidebar_handover.sh" ] && source "$LAUNCHER_DIR/lib/sidebar_handover.sh"
[ -r "$LAUNCHER_DIR/lib/sidebar_archive.sh" ] && source "$LAUNCHER_DIR/lib/sidebar_archive.sh"
source "$SIDEBAR_ADAPTER_PATH"

if [ "$(type -t tmux 2>/dev/null || true)" != function ]; then
    tmux()
    {
        declare -f metrics_external_count >/dev/null 2>&1 && metrics_external_count tmux || true
        sidebar_tmux_cmd "$@"
    }
fi

