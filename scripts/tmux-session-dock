SIDEBAR_WATCHDOG_STALE_SECONDS="${TMUX_SESSION_SIDEBAR_WATCHDOG_STALE_SECONDS:-10}"
# A busy operation (save/delete/restore) is trusted only while its owner
# process is alive and this many seconds have not passed since it began.
SIDEBAR_OPERATION_TTL_SECONDS="${TMUX_SESSION_SIDEBAR_OPERATION_TTL_SECONDS:-120}"
# Hook-suppression flags (sidebar ON toggle, archive restore) are trusted only
