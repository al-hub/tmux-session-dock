# Deadline (epoch ns) until which layout hooks are the product's own doing.
# Written on every layout mutation and by every hook handler, so it lives in
# the hidden environment like the rest of the transient bookkeeping: a
# set-option here redrew every attached client on every hook.
SIDEBAR_LAYOUT_HOOK_GUARD_ENV="DOTFILES_SIDEBAR_LAYOUT_HOOK_GUARD"
SIDEBAR_OWNER_CLIENT_OPTION="@dotfiles_sidebar_owner_client"
# Transient transition/handover bookkeeping (transition, phase, generation, deferred,
# render_pending, handover_rendered, selection_sync(+ack), target_marker) lives in the
# tmux environment as DOTFILES_SIDEBAR_<NAME>[_<scope>] — see sidebar_env_key(). Options
# are avoided there because every set-option redraws all attached clients.
SIDEBAR_TRANSITION_LOCK_DIR=""
SIDEBAR_FAST_TRANSITION_OPTION="@dotfiles_sidebar_fast_transition"

# Handover and transition bookkeeping lives in tmux *environment* variables
# rather than user options: every set-option (any scope) makes the server
# redraw all attached clients (~0.8-4 KB per write), and the handover finishes
# with a burst of such writes right after the target frame is painted — the
# flicker users see after Enter.  set-environment causes no redraw.  The
# variables are hidden (-h): tmux does not export hidden variables into new
# panes, so shells and nested tmux servers never inherit sidebar state.  Window
# scoped flags carry the window id in the variable name.
sidebar_env_key()
{
    local name="$1" scope="${2:-}"
    scope="${scope//[^A-Za-z0-9]/_}"
    printf 'DOTFILES_SIDEBAR_%s%s' "$name" "${scope:+_$scope}"
}

sidebar_env_set()
{
    tmux set-environment -gh "$1" "$2" 2>/dev/null || true
    _tick_prefetch_iter=-1
}

# Several flags in one round trip: sidebar_env_set_many NAME VALUE [NAME VALUE]...
sidebar_env_set_many()
{
    local args=()
    while [ $# -ge 2 ]; do
        args+=(set-environment -gh "$1" "$2" \;)
        shift 2
    done
    [ ${#args[@]} -gt 0 ] || return 0
    unset 'args[-1]'
    tmux "${args[@]}" 2>/dev/null || true
    _tick_prefetch_iter=-1
}

# Every hidden flag in one round trip (show-environment -gh on a single unset
# name fails and aborts a command sequence, so the whole table is read and
# indexed here).  An optional pane target + format is appended to the same
# round trip and lands in SIDEBAR_ENV_MANY[__display].
declare -A SIDEBAR_ENV_MANY=()
sidebar_env_fetch_all()
{
    local out line last="" fmt="${2:-}"
    [ -n "$fmt" ] || fmt='#{session_name}'
    SIDEBAR_ENV_MANY=()
    if [ -n "${1:-}" ]; then
        out="$(tmux show-environment -gh \; display-message -p -t "$1" "$fmt" 2>/dev/null || true)"
    else
        out="$(tmux show-environment -gh 2>/dev/null || true)"
    fi
    while IFS= read -r line; do
        case "$line" in
            DOTFILES_SIDEBAR_*=*) SIDEBAR_ENV_MANY["${line%%=*}"]="${line#*=}" ;;
            *) last="$line" ;;
        esac
    done <<< "$out"
    SIDEBAR_ENV_MANY[__display]="$last"
}

# sidebar_env_key without a fork: sidebar_env_key_v VAR NAME [SCOPE]
sidebar_env_key_v()
{
    local scope="${3:-}"
    scope="${scope//[^A-Za-z0-9]/_}"
    printf -v "$1" 'DOTFILES_SIDEBAR_%s%s' "$2" "${scope:+_$scope}"
}

# Versions before hidden bookkeeping wrote these as plain global variables,
# which tmux exports into every new pane and, through those shells, into any
# tmux server they start (a fresh server then began with a stale
# DOTFILES_SIDEBAR_OPERATION=restoring:... and every presenter took the busy
# fast path).  Remove any plain leftovers once per process.
sidebar_env_purge_legacy()
{
    local names name args=()
    names="$(tmux show-environment -g 2>/dev/null | sed -n 's/^\(DOTFILES_SIDEBAR_[A-Za-z0-9_]*\)=.*/\1/p')" || return 0
    [ -n "$names" ] || return 0
    for name in $names; do
        args+=(set-environment -gu "$name" \;)
    done
    unset 'args[-1]'
    tmux "${args[@]}" 2>/dev/null || true
}

sidebar_env_get()
{
    local out
    out="$(tmux show-environment -gh "$1" 2>/dev/null || true)"
    case "$out" in ''|-*) return 0 ;; esac
    printf '%s' "${out#*=}"
}

