# Runtime flags (input_ready, action_generation, prompt_ready) keep their
# option-style names in the code; the env key is the upper-cased suffix.
sidebar_runtime_env_key()
{
    local option="$1" scope="${2:-}" name
    name="${option#@dotfiles_sidebar_}"
    name="${name//[^A-Za-z0-9_]/_}"
    sidebar_env_key "${name^^}" "$scope"
}
