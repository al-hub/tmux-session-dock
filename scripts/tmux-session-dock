sidebar_runtime_set()
{
    local option="$1" value="$2"
    local opt_clean="${option//[^a-zA-Z0-9_]/_}"
    local ctx="${SIDEBAR_WINDOW_ID:-global}"
    local ctx_clean="${ctx//[^a-zA-Z0-9_]/_}"
    local cache_var="_cache_opt_${ctx_clean}_${opt_clean}"
    printf -v "$cache_var" '%s' "$value"
    if [ -n "${SIDEBAR_WINDOW_ID:-}" ]; then
        tmux set-environment -gh "$(sidebar_runtime_env_key "$option")" "$value" \; \
            set-environment -gh "$(sidebar_runtime_env_key "$option" "$SIDEBAR_WINDOW_ID")" "$value" 2>/dev/null || true
    else
        sidebar_env_set "$(sidebar_runtime_env_key "$option")" "$value"
    fi
}

sidebar_runtime_get()
{
    local option="$1"
    if [ -n "${SIDEBAR_WINDOW_ID:-}" ]; then
        sidebar_env_get "$(sidebar_runtime_env_key "$option" "$SIDEBAR_WINDOW_ID")"
    else
        sidebar_env_get "$(sidebar_runtime_env_key "$option")"
    fi
}

_sidebar_local_action_generation=0
_sidebar_action_generation_dirty=0

flush_action_generation_if_dirty()
{
    [ "${_sidebar_action_generation_dirty:-0}" -eq 1 ] || return 0
    _sidebar_action_generation_dirty=0
    sidebar_runtime_set "$SIDEBAR_ACTION_GENERATION_OPTION" "${_sidebar_local_action_generation:-0}"
}

# Guard flags (@dotfiles_sidebar_provisioning, @dotfiles_sidebar_restore_topology,
# @tmux_batch_busy) suppress hooks and toggles while a toggle or restore is in
# flight.  They are written as "<owner_pid>:<deadline_epoch>" so a writer that
# dies (SIGKILL, server stall) cannot leave the server suppressed forever; a
# legacy value of 1 is honoured, 0/empty is inactive.
sidebar_guard_flag_set()
{
    local option="$1" ttl="${2:-30}"
    sidebar_tmux_cmd set-option -gq "$option" "$$:$(( ${EPOCHSECONDS:-$(date +%s)} + ttl ))" 2>/dev/null || true
}

sidebar_guard_flag_clear()
{
    sidebar_tmux_cmd set-option -gq "$1" 0 2>/dev/null || true
}

sidebar_guard_flag_active()
{
    local value owner_pid deadline
    value="$(sidebar_tmux_cmd show-option -gqv "$1" 2>/dev/null || true)"
    case "$value" in
        ''|0) return 1 ;;
        1) return 0 ;;
        *:*) ;;
        *) return 1 ;;
    esac
    owner_pid="${value%%:*}"
    deadline="${value#*:}"
    case "$owner_pid" in ''|*[!0-9]*) return 1 ;; esac
    case "$deadline" in ''|*[!0-9]*) return 1 ;; esac
    if ! kill -0 "$owner_pid" 2>/dev/null || [ "${EPOCHSECONDS:-$(date +%s)}" -gt "$deadline" ]; then
        trace_event "guard.stale-clear option=$1 value=$value"
        sidebar_tmux_cmd set-option -gq "$1" 0 2>/dev/null || true
        return 1
    fi
    return 0
}

restore_topology_guard_active()
{
    sidebar_guard_flag_active "$SIDEBAR_RESTORE_TOPOLOGY_OPTION" ||
    sidebar_guard_flag_active "$TMUX_BATCH_BUSY_OPTION"
}
