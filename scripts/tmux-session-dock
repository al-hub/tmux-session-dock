# Frame clock in microseconds; 24 fps drives the 24-phase gradient once per second.
SIDEBAR_ANIMATION_FRAME_US="${TMUX_SESSION_SIDEBAR_ANIMATION_FRAME_US:-41667}"
SIDEBAR_IDLE_INTERVAL="${TMUX_SESSION_SIDEBAR_IDLE_INTERVAL:-$SIDEBAR_POLL_TIMEOUT}"
